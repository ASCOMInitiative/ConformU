@page "/"
@namespace ConformU.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conform Universal</title>
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default-base.css">
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="Server" />
    </app>

    <!-- inside of body section and after the div/app tag  -->
    <script src="Content/Scripts/jquery-3.6.4.slim.min.js"></script>

    <div id="conform-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An un-handled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>

    <script>
            // Return position information for a control with the supplied element ID
            GetBoundingClientRect = (elementId) => {
                let rect = null;
                try {
                    rect = document.getElementById(elementId).getBoundingClientRect();
                }
                catch (err) {
                    rect = null;
                }

                return rect;
            };

            // Return size information for the browser window
            GetBoundingWindowRect = () => {
                return new DOMRect(0,
                    0,
                    window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth,
                    window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight);
            }

            // Scroll to the bottom of the page
            function ScrollToBottom(elementId) {
                let top = document.getElementById(elementId).scrollHeight;
                document.getElementById(elementId).scrollTop = top;
                return top;
            };

            // Set element.top for a scroll-able element
            function setScrollTop(elementId, scrollTop) {
                let element = document.getElementById(elementId);
                element.scrollTop = scrollTop;
            }

            // Keep ConformU-specific helpers under one namespace on window so multiple pages can share the same logic without polluting the global scope with separate functions.
            window.conformU = window.conformU || {};

            // Track one resize subscription/observer set per element ID so that each page can register and later clean up its own viewport sizing behaviour.
            window.conformU.autoSizeViewportElementState = window.conformU.autoSizeViewportElementState || {};
            window.conformU.windowResizeState = window.conformU.windowResizeState || {};

            window.conformU.autoSizeViewportElement = (elementId, bottomOffset) => {
                // Remove any previous registration for this element before creating a new one.
                window.conformU.disposeAutoSizeViewportElement(elementId);

                const element = document.getElementById(elementId);
                if (!element) {
                    return;
                }

                const updateHeight = () => {
                    // Measure where the element currently starts in the viewport. This means the computed height automatically reflects wrapped button rows or any other content
                    // above the element that changes height as the page width changes.
                    const rect = element.getBoundingClientRect();

                    // Fill the remaining viewport height, leaving a small bottom margin so the element does not sit directly against the browser edge.
                    const availableHeight = Math.max(0, Math.floor(document.documentElement.clientHeight - rect.top - bottomOffset));
                    element.style.height = `${availableHeight}px`;
                };

                // ResizeObserver catches layout changes that move the element vertically even when the browser window size itself has not changed. The resize event handles viewport size changes directly.
                const resizeObserver = new ResizeObserver(updateHeight);
                resizeObserver.observe(document.body);
                window.addEventListener('resize', updateHeight);

                // Apply the height immediately so the page is correct on first render.
                updateHeight();

                window.conformU.autoSizeViewportElementState[elementId] = {
                    resizeObserver: resizeObserver,
                    updateHeight: updateHeight
                };
            };

            window.conformU.disposeAutoSizeViewportElement = (elementId) => {
                const state = window.conformU.autoSizeViewportElementState[elementId];
                if (!state) {
                    return;
                }

                // Remove the observer and event handler when a page is disposed to avoid keeping unnecessary references alive after navigation.
                window.removeEventListener('resize', state.updateHeight);
                state.resizeObserver.disconnect();
                delete window.conformU.autoSizeViewportElementState[elementId];
            };

            window.conformU.registerWindowResizeCallback = (callbackId, dotNetReference) => {
                // Keep at most one resize handler per callback ID so repeated page renders do not accumulate duplicate subscriptions.
                window.conformU.disposeWindowResizeCallback(callbackId);

                const notifySizeChanged = () => {
                    dotNetReference.invokeMethodAsync('HandleWindowResizeAsync', window.innerWidth, window.innerHeight);
                };

                window.addEventListener('resize', notifySizeChanged);
                window.conformU.windowResizeState[callbackId] = {
                    dotNetReference: dotNetReference,
                    notifySizeChanged: notifySizeChanged
                };

                // Trigger the callback immediately so the page gets the correct initial title before the user resizes the browser window.
                notifySizeChanged();
            };

            window.conformU.disposeWindowResizeCallback = (callbackId) => {
                const state = window.conformU.windowResizeState[callbackId];
                if (!state) {
                    return;
                }

                window.removeEventListener('resize', state.notifySizeChanged);
                delete window.conformU.windowResizeState[callbackId];
            };

    </script>
</body>
</html>
