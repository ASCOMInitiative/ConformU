@using ASCOM.Common

@implements IDisposable

@inherits LayoutComponentBase
@inject ConformLogger conformLogger
@inject ConformConfiguration configuration
@inject SessionState state
@inject IJSRuntime JS

@* Top level page layout including page header at top and navigation bar at left *@
<div class="sidebar">
    <NavMenu />
</div>

@{
    if (isSmallWidth)
        displayVisible = "display: none;";
    else
        displayVisible = "display: block;";
}

<div class="main">
    <div class="top-row px-4">
        <span class="top-row-text top-row-visible" style="@displayVisible">Current&nbsp;Device:&nbsp;</span>
        <span class="top-row-text" style="color: #0366d6;font-weight:bold">@deviceName.Replace(".", ".\u200B") &nbsp;(@deviceTechnology @deviceType @((deviceTechnology == DeviceTechnology.Alpaca) ? alpacaDeviceNumber : ""))</span>
        <a class="top-row-text" href="https://ascom-standards.org" target="_blank">ASCOM Initiative</a>
    </div>

    <div class="content px-4">
        @Body
    </div>
</div>

<RadzenDialog />
<RadzenNotification />
<RadzenContextMenu />
<RadzenTooltip />

@code
{
    string displayVisible = "display: block;";
    bool disposedValue;
    bool isSmallWidth = false;
    private string deviceName;
    private DeviceTypes deviceType;
    private DeviceTechnology deviceTechnology;
    private int alpacaDeviceNumber;
    private DotNetObjectReference<MainLayout> resizeCallbackReference; // Callback from JavaScript when the user resizes the browser window.

    /// <summary>
    /// Event handler for page initialised event
    /// </summary>
    /// <remarks>Hook up an event handler to redisplay the page header whenever the configuration is changed. </remarks>
    protected override async Task OnInitializedAsync()
    {
        state.UiHasChanged += OnUiChanged;
        SetDisplayVariables();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register a JS resize callback once so the page title is recalculated both after the first browser render and on every subsequent window resize.
            resizeCallbackReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("conformU.registerWindowResizeCallback", "MainLayout", resizeCallbackReference);
        }
    }

    /// <summary>
    /// Callback to handle window re-size events
    /// </summary>
    /// <param name="width"></param>
    /// <param name="height"></param>
    /// <returns></returns>
    [JSInvokable]
    public async Task HandleWindowResizeAsync(double width, double height)
    {
        try
        {
            // Generate the device string that will be displayed at the top of the application
            string titleMessage = $"{deviceName.Replace(".", ".\u200B")} ({deviceTechnology} {deviceType} {((deviceTechnology == DeviceTechnology.Alpaca) ? alpacaDeviceNumber : "")})";

            // Calculate whether it is too long to fit if the "Current Device: " text is visible
            bool newIsSmallWidth = titleMessage.Length * 11 > width - 255;

            // Check whether the value has changed, if not return quickly
            if (isSmallWidth == newIsSmallWidth)
                return;

            // Value is different so force a Blazor re-display
            isSmallWidth = newIsSmallWidth;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            conformLogger.LogMessage("MainLayout.HandleWindowResizeAsync", MessageLevel.Error, $"Exception: {ex.Message}\r\n{ex}.");
        }
    }

    /// <summary>
    /// Event hander called when the configuration is changed
    /// </summary>
    /// <param name="caller"></param>
    /// <param name="args"></param>
    private async void OnUiChanged(object caller, EventArgs args)
    {
        try
        {
            //conformLogger.LogMessage("MainLayout.OnUiChanged", MessageLevel.Debug,$"Method called");
            SetDisplayVariables();
            await InvokeAsync(StateHasChanged);
            //conformLogger.LogMessage("MainLayout.OnUiChanged", MessageLevel.Debug, $"Method completed");
        }
        catch (Exception ex)
        {
            conformLogger.LogMessage("MainLayout.OnUiChanged", MessageLevel.Error, $"Exception: {ex}.");
            throw;
        }
    }

    private void SetDisplayVariables()
    {
        if (configuration.Settings.DeviceTechnology == DeviceTechnology.Alpaca)
        {
            deviceName = $"{configuration.Settings.DeviceName} - {configuration.Settings.AlpacaDevice.HostName}:{configuration.Settings.AlpacaDevice.IpPort}";
            alpacaDeviceNumber = configuration.Settings.AlpacaDevice.AlpacaDeviceNumber;
        }
        else
        {
            deviceName = configuration.Settings.DeviceName;
        }
        deviceType = configuration.Settings.DeviceType.GetValueOrDefault(DeviceTypes.Telescope);
        deviceTechnology = configuration.Settings.DeviceTechnology;

    }

    #region Dispose support

    protected virtual void Dispose(bool disposing)
    {
        if (!disposedValue)
        {
            if (disposing)
            {
                state.UiHasChanged -= OnUiChanged;
            }

            disposedValue = true;
        }
    }

    public void Dispose()
    {
        // Do not change this code. Put clean-up code in 'Dispose(bool disposing)' method
        Dispose(disposing: true);
        GC.SuppressFinalize(this);
    }

    #endregion


}